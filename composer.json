{
  "name": "laravel-openvasp/laravel-openvasp",
  "description": "Production-ready OpenVASP protocol package for Laravel.",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": "^8.2",
    "illuminate/support": "^11.0|^12.0",
    "illuminate/database": "^11.0|^12.0",
    "illuminate/routing": "^11.0|^12.0"
  },
  "require-dev": {
    "orchestra/testbench": "^9.0|^10.0",
    "phpunit/phpunit": "^11.0",
    "larastan/larastan": "^2.9",
    "laravel/pint": "^1.18"
  },
  "autoload": {
    "psr-4": {
      "LaravelOpenVasp\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "LaravelOpenVasp\\Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "LaravelOpenVasp\\OpenVaspServiceProvider"
      ]
    }
  },
  "scripts": {
    "test": "phpunit",
    "analyse": "phpstan analyse",
    "lint": "pint"
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
